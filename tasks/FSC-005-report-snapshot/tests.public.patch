+# ── FinSWE-Constraint hidden test (FSC-005): startup report == executed rule ─────────
+def _report_rule(out: str, symbol: str) -> str:
+    line = next(l for l in out.splitlines() if l.strip().startswith(f"{symbol}:"))
+    return line.split("| 룰 ")[1].split()[0]
+
+
+def test_startup_report_matches_executed_rule_for_income_etf(make_config, tmp_path, capsys):
+    from ai_trader.strategy import QuantStrategy
+    # held income ETF a hair below EMA50: the trend strategy would SELL, the income rule HOLDs
+    closes = [100.0] * 59 + [99.9]
+    paper = PaperBroker(tmp_path / "paper.json")
+    from decimal import Decimal
+    paper.market_buy("JEPQ", 5, Decimal("90"), "KRW")
+    engine, _ = build_engine(make_config, tmp_path, closes, mode="rule", strategy=QuantStrategy(), paper=paper)
+    engine.settings.symbols = ["JEPQ"]
+    engine.report_once()
+    reported = _report_rule(capsys.readouterr().out, "JEPQ")
+    executed = engine.step_symbol("JEPQ")["rule"]["action"]
+    assert reported == executed, f"report shows {reported}, engine executes {executed}"
+
+
+def test_startup_report_unchanged_for_regular_stock(make_config, tmp_path, capsys):
+    from ai_trader.strategy import QuantStrategy
+    closes = [100.0] * 60 + [110.0]
+    engine, _ = build_engine(make_config, tmp_path, closes, mode="rule", strategy=QuantStrategy())
+    engine.report_once()
+    reported = _report_rule(capsys.readouterr().out, "005930")
+    executed = engine.step_symbol("005930")["rule"]["action"]
+    assert reported == executed
