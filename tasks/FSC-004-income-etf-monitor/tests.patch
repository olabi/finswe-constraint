+def test_monitor_income_etf_relaxed_criteria_no_false_alarm(make_config, capsys, monkeypatch):
+    # 인컴 ETF: EMA50 0.1% 미세 하회는 완화 기준상 HOLD (SCHD 오경보 케이스) — 신호·알림 없음
+    cfg = make_config()
+    calls = []
+    monkeypatch.setattr("ai_trader.cli._desktop_notify", lambda t, m: calls.append(1))
+    micro = [100.0] * 59 + [99.9]
+    client = TossClient(cfg, transport=holdings_transport("SCHD", micro, qty=10, avg=90.0))
+    n = _scan_holdings(cfg, client, SmaRsiStrategy(), "1d", True, {})
+    out = capsys.readouterr().out
+    assert n == 0 and len(calls) == 0
+
+
+def test_monitor_income_etf_alerts_on_real_decline(make_config, monkeypatch):
+    # 인컴 ETF 라도 EMA50 를 4% 넘게 하회하면 SELL 경보 + 알림
+    cfg = make_config()
+    calls = []
+    monkeypatch.setattr("ai_trader.cli._desktop_notify", lambda t, m: calls.append(1))
+    big = [100.0] * 59 + [95.0]  # EMA50≈99.8 → 5% 하회
+    client = TossClient(cfg, transport=holdings_transport("JEPQ", big, qty=10, avg=90.0))
+    n = _scan_holdings(cfg, client, SmaRsiStrategy(), "1d", True, {})
+    assert n == 1 and len(calls) == 1
+
