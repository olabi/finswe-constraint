--- a/tests/test_news.py
+++ b/tests/test_news.py
@@ -225,3 +225,11 @@ def test_explicit_sentiment_prefix_still_respected_for_real_news():
     # 가격보도가 아닌 진짜 뉴스는 종전대로 명시 접두사를 존중한다
     assert _label_of("[악재] 대형 수주 체결 · 방금") == "악재"  # 키워드와 달라도 접두사 우선
     assert tone_counts(["[호재] 규제당국 조사 착수 · 방금"]) == (1, 0)
+
+
+def test_priced_in_negative_news_with_price_up_is_not_absorbed():
+    # 005935 회귀: 악재 2건 + change +19.5% → '아직 미반영·신중' 이어야 한다
+    label = priced_in_label(["[악재] a · 1일전", "[악재] b · 18시간전"], 0.195)
+    assert "아직 미반영" in label and "신중" in label
+    assert "이미 반영됨" not in label
+
