+def test_snapshot_attaches_news_priced_in_label(make_config, tmp_path):
+    # 악재 + 상승장 → derived 에 '아직 미반영' 라벨이 실려 AI 가 부호를 직접 안 따지게.
+    from ai_trader.strategy import Bars
+
+    engine, _ = build_engine(make_config, tmp_path, GOLDEN_CROSS_CLOSES)
+    bars = Bars.from_closes([100.0 + i * 0.5 for i in range(80)])  # 우상향 → change_3 양수
+    snap = engine._snapshot(bars, None, "005935", news=["[악재] 하락 마감 · 1일전"])
+    assert "아직 미반영" in snap["derived"]["news_priced_in"]
