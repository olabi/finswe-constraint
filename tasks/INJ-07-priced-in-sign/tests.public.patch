diff --git a/tests/test_finswe_inj07.py b/tests/test_finswe_inj07.py
new file mode 100644
index 0000000..fa78367
--- /dev/null
+++ b/tests/test_finswe_inj07.py
@@ -0,0 +1,18 @@
+from ai_trader.news import priced_in_label, tone_counts
+
+
+def _neg_headlines():
+    heads = ["실적 쇼크 적자 전환", "대규모 리콜 악재", "규제 조사 착수 악재"]
+    pos, neg = tone_counts(heads)
+    assert neg > pos  # sanity: the fixture is negative-dominant
+    return heads
+
+
+def test_rally_does_not_absorb_bad_news():
+    label = priced_in_label(_neg_headlines(), 0.19)
+    assert label is not None and "이미 반영" not in label
+
+
+def test_drop_absorbs_bad_news():
+    label = priced_in_label(_neg_headlines(), -0.08)
+    assert label is not None and "이미 반영" in label
